{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "prod": ["default", "!{projectRoot}/**/*.test.ts", "!{projectRoot}/**/*.spec.ts"]
  },
  "cacheDirectory": "./.nx/cache",
  "targetDefaults": {
    "build": {
      "inputs": ["prod"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^prod", "{workspaceRoot}/vitest.shared.ts"],
      "outputs": ["{projectRoot}/coverage"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "^prod", "{workspaceRoot}/eslint.config.mjs"],
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^prod"],
      "dependsOn": ["^build"],
      "cache": true
    }
  },
  "analytics": false
}
