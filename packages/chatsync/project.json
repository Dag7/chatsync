{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "chatsync",
  "projectType": "library",
  "sourceRoot": "packages/chatsync/src",
  "tags": ["package", "node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": ["^build"],
      "options": { "command": "tsc -p tsconfig.build.json", "cwd": "packages/chatsync" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json --noEmit", "cwd": "packages/chatsync" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run --passWithNoTests --configLoader runner", "cwd": "packages/chatsync" }
    },
    "lint": { "executor": "nx:run-commands", "options": { "command": "eslint src", "cwd": "packages/chatsync" } }
  }
}
